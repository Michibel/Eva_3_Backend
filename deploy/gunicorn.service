[Unit]
Description=Gunicorn daemon for Dulce Arte
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/dulcearte
Environment="PATH=/opt/dulcearte/venv/bin"
EnvironmentFile=/opt/dulcearte/.env
ExecStart=/opt/dulcearte/venv/bin/gunicorn \
    --access-logfile /var/log/gunicorn/access.log \
    --error-logfile /var/log/gunicorn/error.log \
    --workers 3 \
    --worker-class sync \
    --worker-connections 1000 \
    --timeout 120 \
    --keep-alive 5 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --bind unix:/run/gunicorn.sock \
    dulcearte.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true

[Install]
WantedBy=multi-user.target